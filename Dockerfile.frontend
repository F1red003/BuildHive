# Stage 1: Build React SPA
FROM node:24-alpine AS builder
WORKDIR /app

COPY buildhive-frontend/package*.json ./
RUN npm ci

COPY buildhive-frontend/ .
RUN npm run build

# Stage 2: Serve via Nginx Alpine and proxy /api calls to BuildHive server
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY buildhive-frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
